# --- Application ---
APP_NAME=prava-bot
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://prava:prava@localhost:5432/prava

# --- Telegram bot / Mini App ---
# Production uses webhooks (NOT long polling). On startup the app registers the webhook to
# {MINI_APP_URL}/telegram/webhook and sets the menu-button Web App URL to MINI_APP_URL.
BOT_TOKEN=
BOT_USERNAME=
# Production: MINI_APP_URL=https://app.prava.uz (must be https outside development).
MINI_APP_URL=http://localhost:5173
TELEGRAM_WEBHOOK_ENABLED=false
# Required when TELEGRAM_WEBHOOK_ENABLED=true; MUST differ from SESSION_SECRET (enforced).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Sessions / auth ---
SESSION_SECRET=change-me-in-production-min-32-characters
ADMIN_TELEGRAM_IDS=
# Bootstrap superadmin(s): seeded with the superadmin role on first login. Must also
# be effective via role resolution (allowlist membership is implied for these).
SUPERADMIN_TELEGRAM_IDS=
DEV_AUTH_ENABLED=true
# Separation-of-duties: when true, an author cannot publish their own sole-authored
# version (hard block); when false (default) it only emits an audit warning.
REQUIRE_SECOND_REVIEWER=false

# --- Frontend ---
FRONTEND_DEV_URL=http://localhost:5173
FRONTEND_DIST_DIR=frontend/dist

# --- Media storage (Railway S3-compatible bucket) ---
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=
MEDIA_PUBLIC_BASE_URL=
MEDIA_PRESIGN_TTL_SECONDS=300
# Media upload hardening caps (docs/spec/09).
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=26214400
MAX_VIDEO_DURATION_MS=60000
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=5000
MAX_GIF_FRAMES=300

# NOTE: legal exam rules (question count, timer, pass threshold) are DOMAIN config
# in app/domain/exam_config.py — never environment variables.
