# --- Application ---
APP_NAME=prava-bot
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://prava:prava@localhost:5432/prava

# --- Telegram bot / Mini App ---
BOT_TOKEN=
BOT_USERNAME=
MINI_APP_URL=http://localhost:5173
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Sessions / auth ---
SESSION_SECRET=change-me-in-production-min-32-characters
ADMIN_TELEGRAM_IDS=
DEV_AUTH_ENABLED=true

# --- Frontend ---
FRONTEND_DEV_URL=http://localhost:5173
FRONTEND_DIST_DIR=frontend/dist

# --- Media storage (Railway S3-compatible bucket) — not used in slice 1 ---
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=
MEDIA_PUBLIC_BASE_URL=

# NOTE: legal exam rules (question count, timer, pass threshold) are DOMAIN config
# in app/domain/exam_config.py — never environment variables.
